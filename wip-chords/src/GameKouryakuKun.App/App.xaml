<Application x:Class="GameKouryakuKun.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!--
    ダークテーマ。OS 既定（明るい）のコントロール外観を使わず、すべて ControlTemplate で描く。
    文字と背景の組み合わせはコントラスト比 4.5:1 以上（WCAG AA）。無効状態も 4.5:1 以上で読める。
    組み合わせの一覧は Core.Tests/ThemeContrastTests.cs が App.xaml から読み取って検査する（Color の x:Key を変えたらテストも直す）。
  -->
  <Application.Resources>
    <!-- ===== 色 ===== -->
    <Color x:Key="C.Bg">#1E1F24</Color>
    <Color x:Key="C.Header">#25272E</Color>
    <Color x:Key="C.Panel">#2A2C33</Color>
    <Color x:Key="C.Well">#16171B</Color>
    <Color x:Key="C.Fg">#E8E8EC</Color>
    <Color x:Key="C.FgStrong">#FFFFFF</Color>
    <Color x:Key="C.Dim">#9A9CA6</Color>
    <Color x:Key="C.Accent">#8FC1FF</Color>
    <Color x:Key="C.Border">#5A5E6B</Color>
    <Color x:Key="C.BtnBg">#3A3D46</Color>
    <Color x:Key="C.BtnFg">#F0F0F4</Color>
    <Color x:Key="C.BtnHoverBg">#4A4E5A</Color>
    <Color x:Key="C.BtnPressedBg">#2E3B52</Color>
    <Color x:Key="C.DisabledBg">#2A2C33</Color>
    <Color x:Key="C.DisabledBorder">#3A3D46</Color>
    <Color x:Key="C.DisabledFg">#A0A3AD</Color>
    <Color x:Key="C.DangerBg">#B3261E</Color>
    <Color x:Key="C.DangerHoverBg">#C9382F</Color>
    <Color x:Key="C.DangerDisabledBg">#5A2420</Color>
    <Color x:Key="C.DangerDisabledFg">#E0B4B0</Color>
    <Color x:Key="C.InputBg">#2F3139</Color>
    <Color x:Key="C.ItemHoverBg">#3F4F6B</Color>
    <Color x:Key="C.ItemSelectedBg">#2E4A73</Color>
    <Color x:Key="C.ItemSelectedInactiveBg">#3A3D46</Color>
    <Color x:Key="C.TooltipBg">#33363F</Color>
    <Color x:Key="C.ProgressFill">#4F8EF7</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Header" Color="{StaticResource C.Header}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="Well" Color="{StaticResource C.Well}"/>
    <SolidColorBrush x:Key="Fg" Color="{StaticResource C.Fg}"/>
    <SolidColorBrush x:Key="FgStrong" Color="{StaticResource C.FgStrong}"/>
    <SolidColorBrush x:Key="Dim" Color="{StaticResource C.Dim}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="BtnBg" Color="{StaticResource C.BtnBg}"/>
    <SolidColorBrush x:Key="BtnFg" Color="{StaticResource C.BtnFg}"/>
    <SolidColorBrush x:Key="BtnHoverBg" Color="{StaticResource C.BtnHoverBg}"/>
    <SolidColorBrush x:Key="BtnPressedBg" Color="{StaticResource C.BtnPressedBg}"/>
    <SolidColorBrush x:Key="DisabledBg" Color="{StaticResource C.DisabledBg}"/>
    <SolidColorBrush x:Key="DisabledBorder" Color="{StaticResource C.DisabledBorder}"/>
    <SolidColorBrush x:Key="DisabledFg" Color="{StaticResource C.DisabledFg}"/>
    <SolidColorBrush x:Key="DangerBg" Color="{StaticResource C.DangerBg}"/>
    <SolidColorBrush x:Key="DangerHoverBg" Color="{StaticResource C.DangerHoverBg}"/>
    <SolidColorBrush x:Key="DangerDisabledBg" Color="{StaticResource C.DangerDisabledBg}"/>
    <SolidColorBrush x:Key="DangerDisabledFg" Color="{StaticResource C.DangerDisabledFg}"/>
    <SolidColorBrush x:Key="InputBg" Color="{StaticResource C.InputBg}"/>
    <SolidColorBrush x:Key="ItemHoverBg" Color="{StaticResource C.ItemHoverBg}"/>
    <SolidColorBrush x:Key="ItemSelectedBg" Color="{StaticResource C.ItemSelectedBg}"/>
    <SolidColorBrush x:Key="ItemSelectedInactiveBg" Color="{StaticResource C.ItemSelectedInactiveBg}"/>
    <SolidColorBrush x:Key="TooltipBg" Color="{StaticResource C.TooltipBg}"/>
    <SolidColorBrush x:Key="ProgressFill" Color="{StaticResource C.ProgressFill}"/>
    <!-- 既定テンプレートが参照するシステム色も暗色に（ContextMenu・選択色など、テンプレートを持たない箇所の保険） -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource C.InputBg}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource C.Fg}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource C.BtnBg}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource C.BtnFg}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource C.DisabledFg}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource C.ItemSelectedBg}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource C.FgStrong}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource C.ItemSelectedInactiveBg}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource C.FgStrong}"/>

    <!-- キーボード操作時のフォーカス枠 -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-2" RadiusX="5" RadiusY="5" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 文字 ===== -->
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>

    <!-- ===== ボタン（通常・ホバー・押下・無効・フォーカス） ===== -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource BtnFg}"/>
      <Setter Property="Background" Value="{StaticResource BtnBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BtnHoverBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource FgStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BtnPressedBg}"/>
              </Trigger>
              <Trigger Property="IsDefault" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- オン／オフを切り替えるボタン（Human Control・表示を止める）。オンは太い明るい枠＋選択色の背景＋太字で、色だけに頼らない（文字も ON/OFF を含める） -->
    <Style x:Key="StateToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource BtnFg}"/>
      <Setter Property="Background" Value="{StaticResource BtnBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BtnHoverBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource FgStrong}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource ItemSelectedBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="Foreground" Value="{StaticResource FgStrong}"/>
                <Setter Property="FontWeight" Value="Bold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 緊急停止など -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource FgStrong}"/>
      <Setter Property="Background" Value="{StaticResource DangerBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerHoverBg}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerHoverBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FgStrong}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DangerDisabledBg}"/>
                <Setter Property="Foreground" Value="{StaticResource DangerDisabledFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== チェックボックス ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5" VerticalAlignment="Center"
                      Background="{StaticResource Well}" BorderBrush="{StaticResource Dim}">
                <Path x:Name="Mark" Data="M 3,8 L 6.5,11.5 L 13,4" Stroke="{StaticResource Accent}" StrokeThickness="2.2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FgStrong}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
                <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource DisabledFg}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== テキストボックス ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="{StaticResource Well}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{StaticResource FgStrong}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource ItemSelectedBg}"/>
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Dim}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledFg}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== コンボボックス（本体・開くボタン・ドロップダウン・項目） ===== -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
      <Border x:Name="Bd" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Fg}" StrokeThickness="1.6"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBg}"/>
          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
          <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource DisabledFg}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource BtnFg}"/>
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter x:Name="Selected" IsHitTestVisible="False" Margin="8,3,26,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Margin="0,1,0,0">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledFg}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource BtnFg}"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource ItemSelectedBg}"/><Setter Property="Foreground" Value="{StaticResource FgStrong}"/></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource ItemHoverBg}"/><Setter Property="Foreground" Value="{StaticResource FgStrong}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledFg}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 一覧（ListBox / ListView）と列見出し ===== -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#262A33"/></Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Selector.IsSelectionActive" Value="False"/></MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ItemSelectedInactiveBg}"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Selector.IsSelectionActive" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ItemSelectedBg}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Padding" Value="2,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#262A33"/></Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Selector.IsSelectionActive" Value="False"/></MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ItemSelectedInactiveBg}"/>
                <Setter Property="Foreground" Value="{StaticResource FgStrong}"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Selector.IsSelectionActive" Value="True"/></MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ItemSelectedBg}"/>
                <Setter Property="Foreground" Value="{StaticResource FgStrong}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource DisabledBorder}" BorderThickness="0,0,1,1" Padding="6,4">
              <ContentPresenter HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="Bold"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 進捗バー ===== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{StaticResource Well}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource ProgressFill}" CornerRadius="2"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== ツールチップ ===== -->
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource BtnFg}"/>
      <Setter Property="Background" Value="{StaticResource TooltipBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,4">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== パネル ===== -->
    <Style x:Key="PanelBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="PanelBody" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Application.Resources>
</Application>
