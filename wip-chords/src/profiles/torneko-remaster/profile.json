// Game Profile（スキーマ v2）: 書けるのは「身体と接続条件」だけです（design.md 最上位原則 7）。
//  - window      : 対象ウィンドウの特定条件
//  - input       : 中立の論理キー名（dpad_up/down/left/right・button1〜32）→ 物理キーの割当、押下時間、禁止キー
// キーの意味・表示名・攻略知識を書く欄はなく、未知のキーや意味を含む論理名は読み込みエラーになります。
// 物理キーは、ユーザーがゲームのキー設定で割り当てたキーです（どのキーが何をするかは AI が経験から学びます）。
{
  "schema_version": 2,
  "profile_id": "torneko-remaster",
  "profile_version": "0.2.0",
  "display_name": "トルネコの大冒険 不思議のダンジョン ちょっとステキなリマスター（Steam）",
  "window": {
    "process_name": "TornekosMysteryDungeon-Win64-Shipping",
    "class_name": "UnrealWindow"
  },
  "input": {
    "default_hold_ms": 80,
    "min_interval_ms": 120,
    "keys": {
      "dpad_up":    "W",
      "dpad_left":  "A",
      "dpad_down":  "S",
      "dpad_right": "D",
      "button1": "Num1",
      "button2": "Num2",
      "button3": "Num3",
      "button4": "Num4",
      "button5": "Num5",
      "button6": "Num6",
      "button7": "Num7",
      "button8": "Num0"
    },
    // OS・ウィンドウ操作・オーバーレイ・終了につながるキーを禁止する（ゲームに依らない安全）
    "forbidden_keys": ["Escape", "F12", "Alt", "Tab"],
    "forbidden_combos": ["Shift+Tab", "Alt+Enter", "Ctrl+W", "Ctrl+Q"]
  }
}
