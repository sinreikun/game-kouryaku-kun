<Window x:Class="GameKouryakuKun.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ゲーム攻略くん" Width="1500" Height="920" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- ヘッダ: タイトル・バッジ・操作 -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Header}" Padding="10,8">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" FontSize="18" FontWeight="Bold" Text="ゲーム攻略くん" VerticalAlignment="Center"/>
          <TextBlock x:Name="VersionText" DockPanel.Dock="Left" Foreground="{StaticResource Dim}" Margin="8,0,16,0" VerticalAlignment="Center"/>
          <WrapPanel x:Name="Badges" VerticalAlignment="Center"/>
        </DockPanel>
        <WrapPanel Margin="0,8,0,0">
          <Button x:Name="ConnectButton" Content="ゲームに接続" Click="Connect_Click"/>
          <Button x:Name="StartButton" Content="▶ 開始" Click="Start_Click" FontWeight="Bold"/>
          <Button x:Name="PauseButton" Content="⏸ 一時停止" Click="Pause_Click"/>
          <Button x:Name="StopButton" Content="■ 停止" Click="Stop_Click"/>
          <Button x:Name="EmergencyButton" Content="緊急停止 (Ctrl+Shift+F9)" Click="Emergency_Click" Style="{StaticResource DangerButton}"/>
          <Rectangle Width="16"/>
          <Button x:Name="OcrButton" Content="OCRテスト" Click="Ocr_Click"/>
          <Button x:Name="SetupButton" Content="セットアップ" Click="Setup_Click"/>
          <Button x:Name="ExportButton" Content="診断データを書き出す" Click="Export_Click" ToolTip="DB（使用中でも一貫したコピー）・ログ・部品の導入記録を1つの zip にまとめ、zip ファイルそのものをクリップボードにコピーします（送り先に Ctrl+V で貼り付け）"/>
          <Button x:Name="ThroughputCompareButton" Content="高速化比較を自動実行（約35分）" Click="ThroughputCompare_Click" ToolTip="ゲームに接続した状態で押すだけ。32 分の探索の中で手ごとに A 基準・B パイプライン・C 適応的静止判定・D 全部 を切り替えて同じ画面どうしで比べ、比較の報告を入れた診断 zip を書き出してクリップボードにコピーします。既定の設定は変えません。止めるときは「停止」"/>
          <Rectangle Width="16"/>
          <TextBlock Text="実行時間" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox x:Name="RunMinutesBox" Width="80" VerticalAlignment="Center" Margin="0,0,8,0" SelectedIndex="0" ToolTip="手探り探索を終える時間。「なし」のときは停止ボタン・手数上限で止めます">
            <ComboBoxItem Content="なし" Tag="0"/>
            <ComboBoxItem Content="10分" Tag="600"/>
            <ComboBoxItem Content="20分" Tag="1200"/>
            <ComboBoxItem Content="30分" Tag="1800"/>
            <ComboBoxItem Content="60分" Tag="3600"/>
          </ComboBox>
          <CheckBox x:Name="SendInputCheck" Content="占有モード(SendInput)を許可"/>
          <CheckBox x:Name="ModeCCheck" Content="高速モード（C）" IsChecked="True" Margin="8,0,0,0" Checked="ModeC_Changed" Unchecked="ModeC_Changed" ToolTip="既定 ON（v0.42.0）。OCR を待たずに次の手へ進み（文字は後から元の手に合流）、画面ごとに静止の待ちを学んで短くし、ゲームが受け付けるまで入力を待ちます。外すと基準の経路（v0.38.0 と同じ）。次の探索から効きます"/>
          <CheckBox x:Name="GrowthTestCheck" Content="成長テスト（計測を細かく）" Margin="8,0,0,0" ToolTip="長い実行・起動をまたぐ実行の推移を 25 手ごとに記録します（探索の手順は同じ）"/>
          <TextBlock x:Name="MaxStepsLabel" Text="手数上限" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox x:Name="MaxStepsBox" Width="56" Text="0" VerticalAlignment="Center" ToolTip="0 = 上限なし。実行時間と併用できます（先に来たほうで終わります）"/>
        </WrapPanel>
        <WrapPanel Margin="0,6,0,0">
          <CheckBox x:Name="AutoRelaunchCheck" Content="ゲームが消えたら自動で起動し直す" VerticalAlignment="Center" Click="Launch_Changed"
                    ToolTip="Supervisor がゲームの終了・ウィンドウの消失を見つけたとき、下の方法でゲームを起動し直します（ゲームの中身には触れません）。OFF なら人が起動し直すのを待ちます"/>
          <ComboBox x:Name="LaunchRouteBox" Width="190" Margin="8,0,4,0" VerticalAlignment="Center" SelectionChanged="Launch_Changed">
            <ComboBoxItem Content="接続したゲーム（自動で記録）" Tag="detected"/>
            <ComboBoxItem Content="実行ファイルを選ぶ" Tag="exe"/>
            <ComboBoxItem Content="Steam app id" Tag="steam"/>
          </ComboBox>
          <TextBox x:Name="LaunchExeBox" Width="260" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Button x:Name="LaunchBrowseButton" Content="参照…" Click="LaunchBrowse_Click" Margin="0,0,8,0"/>
          <TextBlock Text="Steam app id" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox x:Name="SteamIdBox" Width="80" VerticalAlignment="Center" LostFocus="Launch_Changed"/>
          <Button x:Name="WatchFilesButton" Content="見張るファイル…" Click="WatchFiles_Click" Margin="8,0,4,0" ToolTip="変化を見張るファイルを選びます（変化の記録と警告だけで、戻しません）。選び直すと置き換えます。キャンセルで変更なし"/>
          <Button x:Name="WatchResetButton" Content="基準を今にする" Click="WatchReset_Click" ToolTip="見張るファイルの基準を、次の開始のときの状態に取り直します"/>
          <TextBlock x:Name="LaunchInfo" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
        </WrapPanel>
        <WrapPanel Margin="0,6,0,0">
          <ToggleButton x:Name="HumanToggle" Content="○ Human Control: OFF（自動で探索中）" Click="Human_Click" IsEnabled="False" Style="{StaticResource StateToggle}" Margin="0,0,10,0"
                        ToolTip="自動の手の選択だけを止め、人間が攻略くんの入力経路で操作します。画面の観測と記録は続けます。人間の手は世界の観測としてだけ使い、正解・お手本にはしません"/>
          <TextBlock x:Name="HumanKeysLabel" Text="人間の操作のキーは、Human Control が ON のときだけ小さな別の窓に出ます（位置は覚えます）" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- 停止・中止の表示 -->
    <Border x:Name="Banner" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,8" Background="#B3261E">
      <TextBlock x:Name="BannerText" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Foreground="White"/>
    </Border>
    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="540"/>
      </Grid.ColumnDefinitions>
      <!-- 左: ライブ画面 + 観測→行動→結果 ログ -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Border Background="Black" CornerRadius="4">
          <Grid>
            <Viewbox Stretch="Uniform">
              <Grid x:Name="LiveStage">
                <Image x:Name="LiveImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear"/>
                <Canvas x:Name="ObsCanvas" IsHitTestVisible="False"/>
              </Grid>
            </Viewbox>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#80000000">
              <CheckBox x:Name="ObsToggle" Content="見ているもの（重ね表示）" Foreground="#E0FFFFFF" Click="ObsToggle_Click"/>
              <StackPanel Orientation="Horizontal" Margin="16,2,0,0">
                <CheckBox x:Name="ObsRegions" Content="区画" IsChecked="True" Foreground="#E0FFFFFF" Margin="0,0,6,0" Click="ObsToggle_Click"/>
                <CheckBox x:Name="ObsEntities" Content="候補" IsChecked="True" Foreground="#E0FFFFFF" Margin="0,0,6,0" Click="ObsToggle_Click"/>
                <CheckBox x:Name="ObsRelations" Content="関係" IsChecked="False" Foreground="#E0FFFFFF" Margin="0,0,6,0" Click="ObsToggle_Click"/>
                <CheckBox x:Name="ObsTextBoxes" Content="文字" IsChecked="True" Foreground="#E0FFFFFF" Margin="0,0,6,0" Click="ObsToggle_Click"/>
                <CheckBox x:Name="ObsTable" Content="表" IsChecked="True" Foreground="#E0FFFFFF" Margin="0,0,6,0" Click="ObsToggle_Click"/>
                <CheckBox x:Name="ObsFrozen" Content="観測した画面" IsChecked="True" Foreground="#E0FFFFFF" Click="ObsToggle_Click" ToolTip="入: 重ね表示の元になった画面（その手の観測の画面）を止めて表示。切: いまの画面の上に、直前の手の観測を重ねる（ずれることがある）"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="LiveOverlay" Text="ゲームに接続していません" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource Dim}"/>
            <TextBlock x:Name="LiveInfo" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Foreground="#C0FFFFFF" FontSize="11"/>
          </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="観測 → 行動 → 結果" Style="{StaticResource PanelTitle}" Margin="0,8,0,4"/>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="ObsPanel" Grid.Column="1" Width="480" Margin="6,0,0,0" Padding="6" Background="{StaticResource Well}" CornerRadius="3" Visibility="Collapsed">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="見ているもの（表）" Style="{StaticResource PanelTitle}"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ObsText" Style="{StaticResource PanelBody}" FontSize="11" TextWrapping="Wrap"/></ScrollViewer>
            </DockPanel>
          </Border>
        <ListBox Grid.Column="0" x:Name="LogList" Background="{StaticResource Well}" BorderThickness="0" FontFamily="Consolas, BIZ UDGothic, MS Gothic" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </Grid>
      <!-- 右: 1手サマリー・成長（固定）＋ 詳しい欄（スクロール） -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="PanelHolder" Grid.Row="0" Visibility="Collapsed">
          <StackPanel x:Name="SummaryBlock">
            <DockPanel>
              <ToggleButton x:Name="ViewerPauseButton" DockPanel.Dock="Right" Content="⏸ 表示を止める（いまは最新を表示中）" Click="ViewerPause_Click" Style="{StaticResource StateToggle}" Margin="0"
                            ToolTip="表示の更新だけを止めます（探索と記録は続きます）。もう一度押すと最新へ戻ります"/>
                <TextBlock x:Name="SummaryNote" Foreground="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                         Text="○一致 ×外れ ★新発見 ↻修正 ?探索 ◎目的達成"/>
            </DockPanel>
            <ListBox x:Name="SummaryList" Height="190" Background="{StaticResource Well}" BorderThickness="0" FontFamily="Consolas, BIZ UDGothic, MS Gothic" FontSize="12"
                     SelectionChanged="Summary_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Line1}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Line2}" TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SummaryDetail" Style="{StaticResource PanelBody}" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel x:Name="GrowthBlock">
            <TextBlock x:Name="MetersText" Style="{StaticResource PanelBody}" Text="（探索を開始すると表示）"/>
            <DockPanel Margin="0,4,0,0">
              <TextBlock DockPanel.Dock="Left" Text="グラフ: " VerticalAlignment="Center"/>
              <ComboBox x:Name="MetricBox" DockPanel.Dock="Left" Width="260" MinHeight="26" FontSize="13" SelectionChanged="Metric_Changed" ToolTip="表示する指標を選びます（「すべて重ねる」で全部を同時に表示）。表示用で、学習には使いません"/>
              <TextBlock Text="  ★新State ◆新Sequence ↻修正 ◎目的達成（点にマウスを合わせると説明）" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <Canvas x:Name="GraphCanvas" Height="140" Background="{StaticResource Well}" Margin="0,4,0,0" ClipToBounds="True"/>
            <WrapPanel x:Name="GraphLegend" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Row="0" Content="欄の並びを既定に戻す" HorizontalAlignment="Right" Margin="0,0,0,4" Padding="8,2" Click="ResetPanelOrder_Click" ToolTip="右側の欄の並び順を既定に戻します（表示だけ）"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Panels"/>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
