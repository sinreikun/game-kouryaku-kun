<Project Sdk="Microsoft.NET.Sdk">
  <!-- PaddleOCR（ONNX）を ONNX Runtime で動かす OCR エンジン。OS非依存。
       ONNX Runtime のネイティブDLLは同梱せず、セットアップマネージャが components/onnxruntime/<版>/ に導入したものを読む。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GameKouryakuKun.Ocr</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameKouryakuKun.Core\GameKouryakuKun.Core.csproj" />
    <InternalsVisibleTo Include="GameKouryakuKun.Core.Tests" />
  </ItemGroup>
</Project>
