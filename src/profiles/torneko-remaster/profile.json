// Game Profile（スキーマ v2）: 書けるのは「身体と接続条件」だけです（design.md 最上位原則 7）。
//  - window      : 対象ウィンドウの特定条件
//  - input       : 中立の論理キー名（dpad_up/down/left/right・button1〜32）→ 物理キーの割当、押下時間、禁止キー、
//                  身体の条件としての同時押し chords（論理キー名を + でつなぐ。2〜3キー。ここにない同時押しは送らない）
// キーの意味・表示名・攻略知識を書く欄はなく、未知のキーや意味を含む論理名は読み込みエラーになります。
// 物理キーは、ユーザーがゲームのキー設定で割り当てたキーです（どのキーが何をするかは AI が経験から学びます）。
// v0.3.0（アプリ v0.26.0）: button9=Tab を追加（Tab を禁止キーから外す。Shift+Tab は禁止のまま）、chords を追加。
{
  "schema_version": 2,
  "profile_id": "torneko-remaster",
  "profile_version": "0.3.0",
  "display_name": "トルネコの大冒険 不思議のダンジョン ちょっとステキなリマスター（Steam）",
  "window": {
    "process_name": "TornekosMysteryDungeon-Win64-Shipping",
    "class_name": "UnrealWindow"
  },
  "input": {
    "default_hold_ms": 80,
    "min_interval_ms": 120,
    "keys": {
      "dpad_up":    "W",
      "dpad_left":  "A",
      "dpad_down":  "S",
      "dpad_right": "D",
      "button1": "Num1",
      "button2": "Num2",
      "button3": "Num3",
      "button4": "Num4",
      "button5": "Num5",
      "button6": "Num6",
      "button7": "Num7",
      "button8": "Num0",
      "button9": "Tab"
    },
    "chords": [
      "dpad_up+dpad_left", "dpad_up+dpad_right", "dpad_down+dpad_left", "dpad_down+dpad_right",
      "button5+dpad_up", "button5+dpad_down", "button5+dpad_left", "button5+dpad_right",
      "button5+dpad_up+dpad_left", "button5+dpad_up+dpad_right", "button5+dpad_down+dpad_left", "button5+dpad_down+dpad_right",
      "button2+dpad_up", "button2+dpad_down", "button2+dpad_left", "button2+dpad_right",
      "button2+dpad_up+dpad_left", "button2+dpad_up+dpad_right", "button2+dpad_down+dpad_left", "button2+dpad_down+dpad_right",
      "button3+dpad_up+dpad_left", "button3+dpad_up+dpad_right", "button3+dpad_down+dpad_left", "button3+dpad_down+dpad_right"
    ],
    // OS・ウィンドウ操作・オーバーレイ・終了につながるキーを禁止する（ゲームに依らない安全）
    "forbidden_keys": ["Escape", "F12", "Alt"],
    "forbidden_combos": ["Shift+Tab", "Alt+Enter", "Ctrl+W", "Ctrl+Q"]
  }
}
